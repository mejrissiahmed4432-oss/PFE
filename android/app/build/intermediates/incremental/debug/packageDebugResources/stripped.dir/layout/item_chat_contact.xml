<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <!-- Avatar with online dot -->
    <FrameLayout
        android:layout_width="46dp"
        android:layout_height="46dp">

        <TextView
            android:id="@+id/tvContactAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/txt_ab"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/bg_avatar"/>

        <View
            android:id="@+id/viewOnlineDot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/bg_dot_green"
            android:visibility="gone"/>
    </FrameLayout>

    <!-- Name, role, last message -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvContactName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/txt_contact_name"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/textPrimary"
                android:singleLine="true"/>

            <TextView
                android:id="@+id/tvContactTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/txt_2m_ago"
                android:textSize="11sp"
                android:textColor="@color/textHint"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/tvContactLastMessage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/txt_last_message_preview"
                android:textSize="12sp"
                android:textColor="@color/textSecondary"
                android:singleLine="true"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/tvContactUnread"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:gravity="center"
                android:background="@drawable/bg_badge_red"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:text="0"
                android:visibility="gone"
                android:layout_marginStart="6dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvContactRole"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/txt_technician"
            android:textSize="10sp"
            android:textColor="@color/textHint"
            android:layout_marginTop="2dp"/>
    </LinearLayout>

</LinearLayout>
