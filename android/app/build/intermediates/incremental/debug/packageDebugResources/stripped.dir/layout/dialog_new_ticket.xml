<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surfaceColor">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Submit New Ticket"
            android:textColor="@color/textPrimary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Title *"
            android:textColor="@color/textSecondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>
        <EditText
            android:id="@+id/etTicketTitle"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:background="@drawable/bg_input_field"
            android:hint="Brief description of the issue"
            android:textColorHint="@color/textHint"
            android:textColor="@color/textPrimary"
            android:textSize="14sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:inputType="text"
            android:layout_marginBottom="12dp"/>

        <!-- Description -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Description"
            android:textColor="@color/textSecondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>
        <EditText
            android:id="@+id/etTicketDescription"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="@drawable/bg_input_field"
            android:hint="Provide detailed information about the issue..."
            android:textColorHint="@color/textHint"
            android:textColor="@color/textPrimary"
            android:textSize="14sp"
            android:padding="12dp"
            android:gravity="top|start"
            android:inputType="textMultiLine"
            android:layout_marginBottom="12dp"/>

        <!-- Category & Priority row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Category"
                    android:textColor="@color/textSecondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp"/>
                <Spinner
                    android:id="@+id/spTicketCategory"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:background="@drawable/bg_input_field"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Priority"
                    android:textColor="@color/textSecondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp"/>
                <Spinner
                    android:id="@+id/spTicketPriority"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:background="@drawable/bg_input_field"/>
            </LinearLayout>

        </LinearLayout>

        <!-- Equipment selection block (web-like) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Selected Equipment *"
            android:textColor="@color/textSecondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <!-- Case 1: Equipment Selected card view -->
        <LinearLayout
            android:id="@+id/layoutSelectedEqCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_card"
            android:padding="12dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSelectedEqName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dell XPS 13"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/textPrimary"/>

                <TextView
                    android:id="@+id/tvSelectedEqSerialType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SN-12345 • Laptop"
                    android:textSize="11sp"
                    android:textColor="@color/textSecondary"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <Button
                android:id="@+id/btnChangeSelectedEq"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Change"
                android:textSize="11sp"
                style="?android:attr/borderlessButtonStyle"
                android:textColor="@color/colorPrimary"
                android:textAllCaps="false"/>
        </LinearLayout>

        <!-- Case 2: Equipment list selector/search -->
        <LinearLayout
            android:id="@+id/layoutEqSearchSelector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">

            <EditText
                android:id="@+id/etDlgSearchEquipment"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bg_input_field"
                android:hint="Type to search equipment..."
                android:textColorHint="@color/textHint"
                android:textColor="@color/textPrimary"
                android:textSize="13sp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:layout_marginBottom="8dp"/>

            <!-- List container (height restricted like web) -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:background="@drawable/bg_input_field"
                android:padding="4dp">
                
                <LinearLayout
                    android:id="@+id/layoutDlgEquipmentList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>
            </ScrollView>
        </LinearLayout>

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <Button
                android:id="@+id/btnCancelTicket"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cancel"
                style="?android:attr/borderlessButtonStyle"
                android:textColor="@color/textSecondary"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnSubmitTicket"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Submit Ticket"
                android:backgroundTint="@color/colorPrimary"
                android:textColor="@color/white"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
