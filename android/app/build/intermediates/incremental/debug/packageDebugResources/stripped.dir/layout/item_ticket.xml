<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <!-- Row 1: Icon + Number + Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <ImageView
            android:id="@+id/ivTicketIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="4dp"
            android:src="@drawable/ic_nav_tickets"
            android:layout_marginEnd="10dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTicketNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/txt_tkt_001"
                android:textSize="11sp"
                android:textColor="@color/colorPrimaryVariant"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvTicketTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/txt_ticket_title"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/textPrimary"
                android:maxLines="2"
                android:ellipsize="end"/>

        </LinearLayout>

        <TextView
            android:id="@+id/tvTicketStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/txt_open"
            android:textSize="9sp"
            android:textStyle="bold"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:layout_marginStart="8dp"/>

    </LinearLayout>

    <!-- Row 2: Equipment -->
    <TextView
        android:id="@+id/tvTicketEquipment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/txt_equipment_name"
        android:textSize="12sp"
        android:textColor="@color/textSecondary"
        android:layout_marginBottom="4dp"/>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="8dp"/>

    <!-- Row 3: Requester + Priority + Date -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvTicketRequester"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/txt_user_name"
            android:textSize="11sp"
            android:textColor="@color/textHint"/>

        <TextView
            android:id="@+id/tvTicketPriority"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/txt_high"
            android:textSize="10sp"
            android:textStyle="bold"
            android:layout_marginEnd="12dp"/>

        <TextView
            android:id="@+id/tvTicketDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2025-01-01"
            android:textSize="10sp"
            android:textColor="@color/textHint"/>

    </LinearLayout>

</LinearLayout>
