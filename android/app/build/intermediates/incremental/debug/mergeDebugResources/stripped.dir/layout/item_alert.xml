<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/white"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Severity Indicator Bar (Left border strip) -->
        <View
            android:id="@+id/viewSeverityBar"
            android:layout_width="6dp"
            android:layout_height="match_parent"
            android:background="#ef4444" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Title & Status Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_toStartOf="@+id/tvAlertSeverityBadge"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivAlertIcon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_alert"
                        android:tint="#ef4444"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/tvAlertTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sensor Failure"
                        android:textColor="@color/textPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Severity Badge -->
                <TextView
                    android:id="@+id/tvAlertSeverityBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="CRITICAL"
                    android:textColor="#ef4444"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_badge_rejected"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp" />

            </RelativeLayout>

            <!-- Message Description -->
            <TextView
                android:id="@+id/tvAlertMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="The main temperature sensor returned an out-of-range value (125°C)."
                android:textColor="@color/textSecondary"
                android:textSize="13sp"
                android:layout_marginBottom="12dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginBottom="10dp" />

            <!-- Time, Resolution Details & Trigger button -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@+id/btnResolveAlert"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvAlertTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="March 20, 2026 at 14:35"
                        android:textColor="@color/textHint"
                        android:textSize="11sp" />

                    <!-- Resolved Detail line -->
                    <TextView
                        android:id="@+id/tvAlertResolvedDetails"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Resolved by morad.mejri@medina.com at 14:42"
                        android:textColor="@color/successText"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Resolve Action Button -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnResolveAlert"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_alignParentEnd="true"
                    android:text="Resolve"
                    android:textColor="@color/successText"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_nav_item_default"
                    android:paddingHorizontal="12dp"
                    android:visibility="visible" />
            </RelativeLayout>

        </LinearLayout>
    </LinearLayout>

</androidx.cardview.widget.CardView>
