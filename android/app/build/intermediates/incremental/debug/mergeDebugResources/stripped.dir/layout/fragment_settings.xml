<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surfaceColor"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ═══ Page Header ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/txt_account_settings"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/textPrimary"
                android:fontFamily="sans-serif-medium" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/txt_manage_your_account_preferences_and_sett"
                android:textSize="12sp"
                android:textColor="@color/textHint"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- ═══ Security Card ═══ -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/white"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Header Details -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <View
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icon_service_desk"
                        android:layout_marginEnd="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/txt_account_security"
                            android:textColor="@color/textPrimary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/txt_manage_your_credentials_and_authenticati"
                            android:textColor="@color/textHint"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Initial Buttons Selection List -->
                <LinearLayout
                    android:id="@+id/layoutSecurityMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Change Password Trigger -->
                    <LinearLayout
                        android:id="@+id/btnTriggerPasswordForm"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="14dp"
                        android:paddingHorizontal="4dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_lock"
                            android:tint="@color/colorPrimary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/txt_change_password"
                                android:textColor="@color/textPrimary"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/txt_update_your_login_password_periodically"
                                android:textColor="@color/textHint"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_arrow_right"
                            android:tint="@color/textHint" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider" />

                    <!-- Change Email Trigger -->
                    <LinearLayout
                        android:id="@+id/btnTriggerEmailForm"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="14dp"
                        android:paddingHorizontal="4dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_mail"
                            android:tint="@color/colorPrimary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/txt_change_email_address"
                                android:textColor="@color/textPrimary"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvCurrentEmailLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/txt_technician_company_com"
                                android:textColor="@color/textHint"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_arrow_right"
                            android:tint="@color/textHint" />
                    </LinearLayout>

                </LinearLayout>

                <!-- Change Password Expanded Form -->
                <LinearLayout
                    android:id="@+id/layoutPasswordChangeForm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/txt_update_password"
                        android:textColor="@color/textPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp" />

                    <!-- Current Password -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/txt_current_password"
                        android:textColor="@color/textSecondary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_input_field"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="12dp"
                        android:layout_marginBottom="14dp">

                        <EditText
                            android:id="@+id/etCurrentPassword"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="@string/txt_enter_current_password"
                            android:textColor="@color/textPrimary"
                            android:textColorHint="@color/textHint"
                            android:textSize="14sp"
                            android:inputType="textPassword"
                            android:singleLine="true" />

                        <ImageButton
                            android:id="@+id/btnToggleCurrentPassword"
                            android:layout_width="36dp"
                            android:layout_height="match_parent"
                            android:background="@android:color/transparent"
                            android:src="@drawable/ic_eye_off"
                            android:tint="@color/textHint" />
                    </LinearLayout>

                    <!-- New Password -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/txt_new_password"
                        android:textColor="@color/textSecondary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_input_field"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="12dp"
                        android:layout_marginBottom="6dp">

                        <EditText
                            android:id="@+id/etNewPassword"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="@string/txt_minimum_8_characters"
                            android:textColor="@color/textPrimary"
                            android:textColorHint="@color/textHint"
                            android:textSize="14sp"
                            android:inputType="textPassword"
                            android:singleLine="true" />

                        <ImageButton
                            android:id="@+id/btnToggleNewPassword"
                            android:layout_width="36dp"
                            android:layout_height="match_parent"
                            android:background="@android:color/transparent"
                            android:src="@drawable/ic_eye_off"
                            android:tint="@color/textHint" />
                    </LinearLayout>

                    <!-- Strength Meter -->
                    <LinearLayout
                        android:id="@+id/layoutStrengthMeter"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="14dp"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="120dp"
                            android:layout_height="4dp"
                            android:orientation="horizontal"
                            android:layout_marginEnd="8dp">

                            <View
                                android:id="@+id/strengthBar1"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="#e2e8f0"
                                android:layout_marginEnd="2dp" />

                            <View
                                android:id="@+id/strengthBar2"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="#e2e8f0"
                                android:layout_marginEnd="2dp" />

                            <View
                                android:id="@+id/strengthBar3"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="#e2e8f0"
                                android:layout_marginEnd="2dp" />

                            <View
                                android:id="@+id/strengthBar4"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="#e2e8f0" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvStrengthLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/txt_weak"
                            android:textColor="@color/errorText"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Confirm Password -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/txt_confirm_new_password"
                        android:textColor="@color/textSecondary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_input_field"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="12dp"
                        android:layout_marginBottom="20dp">

                        <EditText
                            android:id="@+id/etConfirmPassword"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="@string/txt_confirm_your_new_password"
                            android:textColor="@color/textPrimary"
                            android:textColorHint="@color/textHint"
                            android:textSize="14sp"
                            android:inputType="textPassword"
                            android:singleLine="true" />

                        <ImageButton
                            android:id="@+id/btnToggleConfirmPassword"
                            android:layout_width="36dp"
                            android:layout_height="match_parent"
                            android:background="@android:color/transparent"
                            android:src="@drawable/ic_eye_off"
                            android:tint="@color/textHint" />
                    </LinearLayout>

                    <!-- Actions -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnSavePassword"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_weight="1"
                            android:text="@string/txt_save_password"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_button_gradient"
                            android:layout_marginEnd="8dp" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnCancelPasswordChange"
                            android:layout_width="wrap_content"
                            android:layout_height="46dp"
                            android:text="@string/txt_cancel"
                            android:textColor="@color/textSecondary"
                            android:textSize="13sp"
                            android:background="@android:color/transparent"
                            android:paddingHorizontal="16dp" />
                    </LinearLayout>

                </LinearLayout>

                <!-- Change Email Expanded Form -->
                <LinearLayout
                    android:id="@+id/layoutEmailChangeForm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/txt_change_email_address"
                        android:textColor="@color/textPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp" />

                    <!-- New Email -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/txt_new_email_address"
                        android:textColor="@color/textSecondary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_input_field"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="12dp"
                        android:layout_marginBottom="14dp">

                        <EditText
                            android:id="@+id/etNewEmail"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@null"
                            android:hint="@string/txt_enter_new_email_address"
                            android:textColor="@color/textPrimary"
                            android:textColorHint="@color/textHint"
                            android:textSize="14sp"
                            android:inputType="textEmailAddress"
                            android:singleLine="true" />
                    </LinearLayout>

                    <!-- Confirm Email -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/txt_confirm_new_email"
                        android:textColor="@color/textSecondary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_input_field"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="12dp"
                        android:layout_marginBottom="14dp">

                        <EditText
                            android:id="@+id/etConfirmEmail"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@null"
                            android:hint="@string/txt_repeat_new_email_address"
                            android:textColor="@color/textPrimary"
                            android:textColorHint="@color/textHint"
                            android:textSize="14sp"
                            android:inputType="textEmailAddress"
                            android:singleLine="true" />
                    </LinearLayout>

                    <!-- Confirm with Password -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/txt_confirm_with_password"
                        android:textColor="@color/textSecondary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_input_field"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="12dp"
                        android:layout_marginBottom="6dp">

                        <EditText
                            android:id="@+id/etEmailConfirmPassword"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="@string/txt_enter_your_password_to_authorize_change"
                            android:textColor="@color/textPrimary"
                            android:textColorHint="@color/textHint"
                            android:textSize="14sp"
                            android:inputType="textPassword"
                            android:singleLine="true" />

                        <ImageButton
                            android:id="@+id/btnToggleEmailConfirmPassword"
                            android:layout_width="36dp"
                            android:layout_height="match_parent"
                            android:background="@android:color/transparent"
                            android:src="@drawable/ic_eye_off"
                            android:tint="@color/textHint" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/txt_your_password_is_required_to_securely_up"
                        android:textColor="@color/textHint"
                        android:textSize="11sp"
                        android:layout_marginBottom="20dp" />

                    <!-- Actions -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnSaveEmail"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_weight="1"
                            android:text="@string/txt_save_email_address"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_button_gradient"
                            android:layout_marginEnd="8dp" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnCancelEmailChange"
                            android:layout_width="wrap_content"
                            android:layout_height="46dp"
                            android:text="@string/txt_cancel"
                            android:textColor="@color/textSecondary"
                            android:textSize="13sp"
                            android:background="@android:color/transparent"
                            android:paddingHorizontal="16dp" />
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
