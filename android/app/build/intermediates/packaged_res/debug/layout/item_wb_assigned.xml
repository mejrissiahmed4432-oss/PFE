<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="8dp"
    android:background="@drawable/bg_badge_available"
    android:backgroundTint="#e0f2fe"
    android:gravity="center_vertical"
    android:layout_marginBottom="4dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvWbAssignedName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RAM Module 8GB"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#0369a1"/>

        <TextView
            android:id="@+id/tvWbAssignedType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hardware x1"
            android:textSize="9sp"
            android:textColor="#0284c7"/>
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnWbAssignedRemove"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_logout"
        android:padding="4dp"
        android:contentDescription="Remove resource"/>

</LinearLayout>
