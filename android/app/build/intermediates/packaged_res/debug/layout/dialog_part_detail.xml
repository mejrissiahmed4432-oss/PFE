<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="20dp">

    <!-- Header Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tvPartDlgTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Part Allocation Detail"
            android:textColor="@color/textPrimary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnPartDlgClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_logout"
            app:tint="@color/textSecondary"
            android:contentDescription="Close" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"
        android:layout_marginBottom="16dp"/>

    <!-- Main Detail Info Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_input_field"
        android:padding="16dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tvPartDlgName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Intel Core i7-12700K"
            android:textColor="@color/textPrimary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvPartDlgCategoryBrand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Category: Processors | Brand: Intel"
            android:textColor="@color/textSecondary"
            android:textSize="12sp"
            android:layout_marginBottom="12dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginBottom="12dp"/>

        <!-- Details Grid -->
        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TableRow android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Serial Number: "
                    android:textColor="@color/textSecondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvPartDlgSN"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="INT-928374-X"
                    android:textColor="@color/textPrimary"
                    android:textSize="13sp"
                    android:paddingStart="8dp"/>
            </TableRow>

            <TableRow android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Specifications: "
                    android:textColor="@color/textSecondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvPartDlgSpecs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12th Gen, 12-Core, 5.0 GHz"
                    android:textColor="@color/textPrimary"
                    android:textSize="13sp"
                    android:paddingStart="8dp"
                    android:singleLine="false"/>
            </TableRow>

            <TableRow android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Location: "
                    android:textColor="@color/textSecondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvPartDlgLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍 Shelf #4 (Row A)"
                    android:textColor="@color/textPrimary"
                    android:textSize="13sp"
                    android:paddingStart="8dp"/>
            </TableRow>

            <TableRow>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quantity: "
                    android:textColor="@color/textSecondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvPartDlgQty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1"
                    android:textColor="@color/textPrimary"
                    android:textSize="13sp"
                    android:paddingStart="8dp"/>
            </TableRow>
        </TableLayout>
    </LinearLayout>

    <!-- Request Info Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_input_field"
        android:padding="16dp"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Request Metadata"
            android:textColor="@color/textPrimary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:layout_marginBottom="8dp"/>

        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TableRow android:layout_marginBottom="4dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Allocated Status: "
                    android:textColor="@color/textSecondary"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/tvPartDlgStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Approved"
                    android:textColor="@color/colorPrimary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:paddingStart="8dp"/>
            </TableRow>

            <TableRow android:layout_marginBottom="4dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Request ID: "
                    android:textColor="@color/textSecondary"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/tvPartDlgReqId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="#REQ-9238"
                    android:textColor="@color/textPrimary"
                    android:textSize="12sp"
                    android:paddingStart="8dp"/>
            </TableRow>

            <TableRow>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Purpose/Desc: "
                    android:textColor="@color/textSecondary"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/tvPartDlgReqDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Upgrade client database storage setup"
                    android:textColor="@color/textPrimary"
                    android:textSize="12sp"
                    android:paddingStart="8dp"/>
            </TableRow>
        </TableLayout>
    </LinearLayout>

    <!-- Bottom Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnPartDlgReturn"
            android:layout_width="wrap_content"
            android:layout_height="45dp"
            android:text="Return to Stock"
            android:textColor="@color/white"
            android:backgroundTint="@color/colorPrimary"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            style="?android:attr/borderlessButtonStyle"/>
    </LinearLayout>
</LinearLayout>
