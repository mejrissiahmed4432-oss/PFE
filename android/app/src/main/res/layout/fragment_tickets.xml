<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F4F6">

    <!-- Main content column -->
    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ===== HEADER ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="18dp"
            android:paddingBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/txt_service_desk"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#1E293B"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/txt_manage_tickets_and_equipment"
                android:textSize="12sp"
                android:textColor="#64748B"
                android:layout_marginTop="2dp"/>

            <!-- Stats Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/bg_stat_card_open"
                    android:padding="10dp"
                    android:layout_marginEnd="6dp">
                    <TextView
                        android:id="@+id/tvStatOpen"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#ef4444"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/txt_open"
                        android:textSize="10sp"
                        android:textColor="#B0C4DE"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/bg_stat_card_open"
                    android:padding="10dp"
                    android:layout_marginEnd="6dp">
                    <TextView
                        android:id="@+id/tvStatInProgress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#f59e0b"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/txt_in_progress"
                        android:textSize="10sp"
                        android:textColor="#B0C4DE"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/bg_stat_card_open"
                    android:padding="10dp">
                    <TextView
                        android:id="@+id/tvStatResolved"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#22c55e"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/txt_resolved"
                        android:textSize="10sp"
                        android:textColor="#B0C4DE"/>
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>

        <!-- ===== TAB BAR ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#FFFFFF"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/tabTickets"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/txt_tickets"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary"
                android:paddingBottom="8dp"
                android:paddingEnd="16dp"
                android:layout_marginEnd="16dp"/>

            <TextView
                android:id="@+id/tabEquipment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/txt_equipment"
                android:textSize="14sp"
                android:textColor="#9CA3AF"
                android:paddingBottom="8dp"
                android:paddingEnd="16dp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="6dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:background="@drawable/bg_input_field"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:layout_marginEnd="8dp">

                <EditText
                    android:id="@+id/etSearch"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:hint="@string/txt_search_tickets"
                    android:textSize="13sp"
                    android:textColor="@color/textPrimary"
                    android:textColorHint="@color/textHint"
                    android:background="@null"
                    android:singleLine="true"
                    android:imeOptions="actionSearch"/>

                <ImageButton
                    android:id="@+id/btnScanQR"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_camera"
                    android:tint="@color/textSecondary"
                    android:padding="4dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnToggleFilters"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_input_field"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <TextView
                    android:id="@+id/tvToggleFiltersLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/txt_filters"
                    android:textSize="12sp"
                    android:textColor="@color/textSecondary"
                    android:textStyle="bold"/>
            </LinearLayout>

        </LinearLayout>

        <!-- ===== FILTER PANEL (EXPANDABLE) ===== -->
        <LinearLayout
            android:id="@+id/layoutFilterPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="10dp"
            android:background="@color/surfaceColor"
            android:visibility="gone">

            <!-- Ticket Filters Container -->
            <LinearLayout
                android:id="@+id/layoutTicketFilters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/txt_status"
                    android:textSize="12sp"
                    android:textColor="@color/textSecondary"
                    android:layout_marginEnd="8dp"/>

                <Spinner
                    android:id="@+id/spTicketStatus"
                    android:layout_width="160dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_input_field"/>

            </LinearLayout>

            <!-- Equipment Filters Container -->
            <LinearLayout
                android:id="@+id/layoutEquipmentFilters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/txt_category"
                    android:textSize="12sp"
                    android:textColor="@color/textSecondary"
                    android:layout_marginEnd="8dp"/>
                <Spinner
                    android:id="@+id/spEqCategory"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_input_field"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/txt_status"
                    android:textSize="12sp"
                    android:textColor="@color/textSecondary"
                    android:layout_marginEnd="8dp"/>
                <Spinner
                    android:id="@+id/spEqStatus"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_input_field"/>

            </LinearLayout>

        </LinearLayout>

        <!-- Create Ticket Button -->
        <Button
            android:id="@+id/btnCreateTicket"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            android:text="@string/txt_create_new_ticket"
            android:textColor="@color/white"
            android:backgroundTint="@color/colorPrimary"
            android:textAllCaps="false"/>

        <!-- ===== CONTENT AREA ===== -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTickets"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="6dp"
                android:paddingBottom="80dp"
                android:clipToPadding="false"
                android:scrollbars="none"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvEquipment"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="6dp"
                android:paddingBottom="80dp"
                android:clipToPadding="false"
                android:scrollbars="none"
                android:visibility="gone"/>

            <LinearLayout
                android:id="@+id/layoutEmpty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/ic_nav_tickets"
                    android:alpha="0.3"/>

                <TextView
                    android:id="@+id/tvEmpty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/txt_no_tickets_found"
                    android:textSize="14sp"
                    android:textColor="@color/textHint"
                    android:layout_marginTop="12dp"/>

            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressTickets"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:visibility="gone"/>

        </FrameLayout>

    </LinearLayout>

</RelativeLayout>
