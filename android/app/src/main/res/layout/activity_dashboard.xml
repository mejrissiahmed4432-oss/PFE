<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false">

    <!-- ═══════════════════════════════════════════════
         MAIN CONTENT AREA
    ═══════════════════════════════════════════════ -->
    <!-- ═══════════════════════════════════════════════
         MAIN CONTENT AREA
    ═══════════════════════════════════════════════ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/surfaceColor">

            <!-- Top Bar -->
            <LinearLayout
                android:id="@+id/topBar"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="4dp"
                android:paddingEnd="16dp"
                android:background="@color/topbarBg"
                android:elevation="4dp">

                <!-- Hamburger / Menu Button -->
                <ImageButton
                    android:id="@+id/btnOpenDrawer"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="12dp"
                    android:src="@drawable/ic_menu"
                    android:contentDescription="Open menu"
                    android:tint="@color/textSecondary"/>

                <!-- Page Title + Subtitle -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="4dp">

                    <TextView
                        android:id="@+id/tvPageTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Support Tickets"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/textPrimary"
                        android:fontFamily="sans-serif-medium"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/medinaflux_platform"
                        android:textSize="10sp"
                        android:textColor="@color/textHint"
                        android:letterSpacing="0.08"/>
                </LinearLayout>

                <!-- Topbar Actions Container -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginEnd="8dp">

                    <!-- AI Assistant -->
                    <ImageButton
                        android:id="@+id/btnAI"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_ai"
                        android:tint="@color/textSecondary"
                        android:scaleType="fitCenter"
                        android:padding="6dp"
                        android:contentDescription="AI assistant"
                        android:layout_marginEnd="2dp" />

                    <!-- Language Selector -->
                    <ImageButton
                        android:id="@+id/btnLanguage"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_language"
                        android:tint="@color/textSecondary"
                        android:scaleType="fitCenter"
                        android:padding="6dp"
                        android:contentDescription="Change Language"
                        android:layout_marginEnd="2dp" />

                    <!-- Dark Mode Toggle -->
                    <ImageButton
                        android:id="@+id/btnModeToggle"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_mode_toggle"
                        android:tint="@color/textSecondary"
                        android:scaleType="fitCenter"
                        android:padding="6dp"
                        android:contentDescription="Toggle Dark Mode"
                        android:layout_marginEnd="2dp" />

                    <!-- Alert Indicator with badge -->
                    <FrameLayout
                        android:id="@+id/btnAlertContainer"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="2dp">
                        <ImageButton
                            android:id="@+id/btnAlert"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_alert"
                            android:tint="@color/textSecondary"
                            android:scaleType="fitCenter"
                            android:padding="6dp"
                            android:contentDescription="Alerts" />
                        <TextView
                            android:id="@+id/tvAlertBadge"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:gravity="center"
                            android:background="@drawable/bg_badge_red"
                            android:textColor="@color/white"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:text="0"
                            android:layout_gravity="top|end"
                            android:layout_marginTop="2dp"
                            android:layout_marginEnd="2dp"
                            android:visibility="gone" />
                    </FrameLayout>

                    <!-- Notification bell with badge -->
                    <FrameLayout
                        android:id="@+id/btnNotificationContainer"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="2dp">
                        <ImageButton
                            android:id="@+id/btnNotification"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_notification"
                            android:tint="@color/textSecondary"
                            android:scaleType="fitCenter"
                            android:padding="6dp"
                            android:contentDescription="Notifications" />
                        <TextView
                            android:id="@+id/tvNotificationBadge"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:gravity="center"
                            android:background="@drawable/bg_badge_red"
                            android:textColor="@color/white"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:text="0"
                            android:layout_gravity="top|end"
                            android:layout_marginTop="2dp"
                            android:layout_marginEnd="2dp"
                            android:visibility="gone" />
                    </FrameLayout>

                </LinearLayout>

                <!-- Clickable User Avatar Container -->
                <LinearLayout
                    android:id="@+id/layoutUserAvatar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless">

                    <TextView
                        android:id="@+id/tvUserAvatar"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_avatar"
                        android:text="MM"/>

                </LinearLayout>
            </LinearLayout>

            <!-- Fragment Container -->
            <FrameLayout
                android:id="@+id/fragmentContainer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>

        </LinearLayout>

        <!-- FLOATING PROFILE DROPDOWN CARD -->
        <androidx.cardview.widget.CardView
            android:id="@+id/profileDropdownCard"
            android:layout_width="230dp"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="58dp"
            android:layout_marginEnd="12dp"
            android:visibility="gone"
            app:cardCornerRadius="12dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <!-- User Profile Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvDropdownAvatar"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_avatar"
                        android:text="MM"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="10dp">

                        <TextView
                            android:id="@+id/tvDropdownName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Morad Mejri"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/textPrimary"
                            android:singleLine="true"/>

                        <TextView
                            android:id="@+id/tvDropdownEmail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="morad.mejri@medina.com"
                            android:textSize="10sp"
                            android:textColor="@color/textHint"
                            android:singleLine="true"/>
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider"
                    android:layout_marginVertical="4dp"/>

                <!-- Profile Item -->
                <LinearLayout
                    android:id="@+id/menuProfile"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_mail"
                        android:tint="@color/textSecondary" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="My Profile"
                        android:textSize="13sp"
                        android:textColor="@color/textPrimary"/>
                </LinearLayout>

                <!-- Settings Item -->
                <LinearLayout
                    android:id="@+id/menuSettings"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_nav_settings"
                        android:tint="@color/textSecondary" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Account Settings"
                        android:textSize="13sp"
                        android:textColor="@color/textPrimary"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider"
                    android:layout_marginVertical="4dp"/>

                <!-- Logout Item -->
                <LinearLayout
                    android:id="@+id/menuLogout"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sign Out"
                        android:textSize="13sp"
                        android:textColor="#ef4444"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- FLOATING NOTIFICATION DROPDOWN CARD -->
        <androidx.cardview.widget.CardView
            android:id="@+id/notificationDropdownCard"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="58dp"
            android:layout_marginEnd="50dp"
            android:visibility="gone"
            app:cardCornerRadius="12dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Header Details -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:text="Notifications"
                        android:textColor="@color/textPrimary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnMarkAllRead"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="Mark all as read"
                        android:textColor="@color/colorPrimary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true" />
                </RelativeLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider" />

                <!-- Notifications Scroll Container -->
                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/layoutNotificationsList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Programmatically populated -->

                    </LinearLayout>
                </ScrollView>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider" />

                <!-- Footer clear all button -->
                <TextView
                    android:id="@+id/btnClearAllNotifications"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:gravity="center"
                    android:text="Clear All"
                    android:textColor="@color/textSecondary"
                    android:textSize="12sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- GLOBAL AI ASSISTANT FLOATING ACTION BUTTON (FAB) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/btnAiFab"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="8dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless">
            
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_ai_fab">
                
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_centerInParent="true"
                    android:src="@drawable/ic_ai"
                    android:tint="@color/white" />
            </RelativeLayout>
        </androidx.cardview.widget.CardView>

    </FrameLayout>

    <!-- ═══════════════════════════════════════════════
         NAVIGATION DRAWER (SIDEBAR)  — start edge
    ═══════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/navDrawer"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="@drawable/bg_sidebar"
        android:fitsSystemWindows="false">

        <!-- ── Header / Brand ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <!-- Logo Icon Box -->
            <LinearLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:background="@drawable/bg_logo_box">
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/logo"
                    android:scaleType="fitCenter"/>
            </LinearLayout>

            <!-- Brand Name -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Medina"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.02"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Flux"
                    android:textColor="@color/colorAccent"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.02"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Thin divider under header -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/sidebarBorder"
            android:alpha="0.5"/>

        <!-- ── Navigation Items ── -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/navItemsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <!-- Dashboard -->
                <LinearLayout
                    android:id="@+id/navDashboard"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:background="@drawable/bg_nav_item_default"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginBottom="4dp">
                    <ImageView
                        android:id="@+id/iconDashboard"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_nav_dashboard"
                        android:tint="@color/sidebarText"/>
                    <TextView
                        android:id="@+id/labelDashboard"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="@string/nav_dashboard"
                        android:textSize="14sp"
                        android:textColor="@color/sidebarText"
                        android:fontFamily="sans-serif-medium"/>
                </LinearLayout>

                <!-- Section Label: INVENTORY -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="INVENTORY"
                    android:textSize="10sp"
                    android:textColor="@color/sidebarSection"
                    android:letterSpacing="0.1"
                    android:textAllCaps="true"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="6dp"/>

                <!-- Parts -->
                <LinearLayout
                    android:id="@+id/navParts"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:background="@drawable/bg_nav_item_default"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginBottom="4dp">
                    <ImageView
                        android:id="@+id/iconParts"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_nav_parts"
                        android:tint="@color/sidebarText"/>
                    <TextView
                        android:id="@+id/labelParts"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="@string/nav_parts"
                        android:textSize="14sp"
                        android:textColor="@color/sidebarText"
                        android:fontFamily="sans-serif-medium"/>
                </LinearLayout>

                <!-- Section Label: MANAGEMENT -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MANAGEMENT"
                    android:textSize="10sp"
                    android:textColor="@color/sidebarSection"
                    android:letterSpacing="0.1"
                    android:textAllCaps="true"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="6dp"/>

                <!-- Schedule -->
                <LinearLayout
                    android:id="@+id/navSchedule"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:background="@drawable/bg_nav_item_default"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginBottom="4dp">
                    <ImageView
                        android:id="@+id/iconSchedule"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_nav_schedule"
                        android:tint="@color/sidebarText"/>
                    <TextView
                        android:id="@+id/labelSchedule"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="@string/nav_schedule"
                        android:textSize="14sp"
                        android:textColor="@color/sidebarText"
                        android:fontFamily="sans-serif-medium"/>
                </LinearLayout>

                <!-- Reports -->
                <LinearLayout
                    android:id="@+id/navReports"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:background="@drawable/bg_nav_item_default"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginBottom="4dp">
                    <ImageView
                        android:id="@+id/iconReports"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_nav_reports"
                        android:tint="@color/sidebarText"/>
                    <TextView
                        android:id="@+id/labelReports"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="@string/nav_reports"
                        android:textSize="14sp"
                        android:textColor="@color/sidebarText"
                        android:fontFamily="sans-serif-medium"/>
                </LinearLayout>

                <!-- Requests -->
                <LinearLayout
                    android:id="@+id/navRequests"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:background="@drawable/bg_nav_item_default"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginBottom="4dp">
                    <ImageView
                        android:id="@+id/iconRequests"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_nav_requests"
                        android:tint="@color/sidebarText"/>
                    <TextView
                        android:id="@+id/labelRequests"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="@string/nav_requests"
                        android:textSize="14sp"
                        android:textColor="@color/sidebarText"
                        android:fontFamily="sans-serif-medium"/>
                </LinearLayout>

                <!-- Support Tickets (active by default) -->
                <LinearLayout
                    android:id="@+id/navTickets"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:background="@drawable/bg_nav_item_active"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginBottom="4dp">
                    <ImageView
                        android:id="@+id/iconTickets"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_nav_tickets"
                        android:tint="@color/white"/>
                    <TextView
                        android:id="@+id/labelTickets"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="@string/nav_tickets"
                        android:textSize="14sp"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"/>
                    <!-- Badge -->
                    <TextView
                        android:id="@+id/badgeTickets"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:gravity="center"
                        android:background="@drawable/bg_badge_red"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:text="1"
                        android:visibility="visible"/>
                </LinearLayout>

                <!-- Chat / Messages -->
                <LinearLayout
                    android:id="@+id/navChat"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:background="@drawable/bg_nav_item_default"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginBottom="4dp">
                    <ImageView
                        android:id="@+id/iconChat"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_nav_chat"
                        android:tint="@color/sidebarText"/>
                    <TextView
                        android:id="@+id/labelChat"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="@string/nav_chat"
                        android:textSize="14sp"
                        android:textColor="@color/sidebarText"
                        android:fontFamily="sans-serif-medium"/>
                    <!-- Badge -->
                    <TextView
                        android:id="@+id/badgeChat"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:gravity="center"
                        android:background="@drawable/bg_badge_red"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:text="0"
                        android:visibility="gone"/>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- Thin divider above footer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/sidebarBorder"
            android:alpha="0.4"/>

        <!-- ── Footer: Account Settings ── -->
        <LinearLayout
            android:id="@+id/navSettings"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="16dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_nav_settings"
                android:tint="@color/sidebarText"/>
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="@string/nav_settings"
                android:textSize="13sp"
                android:textColor="@color/sidebarText"
                android:fontFamily="sans-serif-medium"/>
        </LinearLayout>

        <!-- Logout -->
        <LinearLayout
            android:id="@+id/navLogout"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="16dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/logout"
                android:textSize="13sp"
                android:textColor="#ef4444"
                android:fontFamily="sans-serif-medium"/>
        </LinearLayout>

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
